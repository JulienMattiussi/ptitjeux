{
  "name": "ptitjeux",
  "description": "Mini-jeux logico-spatiaux quotidiens : Boucle, Angle mort, Sokomot et Sémantogramme. 100 % front-end.",
  "author": "YavaDeus",
  "license": "MIT",
  "homepage": "https://ptitjeux.yavadeus.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/JulienMattiussi/ptitjeux.git"
  },
  "bugs": {
    "url": "https://github.com/JulienMattiussi/ptitjeux/issues"
  },
  "keywords": [
    "puzzle",
    "casse-tete",
    "jeux",
    "logique",
    "slitherlink",
    "sokoban",
    "nonogram",
    "react-router"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"generators/**/*.ts\" \"scripts/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"generators/**/*.ts\" \"scripts/**/*.ts\" \"*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:levels": "vitest run --config vitest.levels.config.ts",
    "generate:levels": "tsx scripts/generate-levels.ts"
  },
  "dependencies": {
    "@react-router/node": "7.18.4",
    "@react-router/serve": "7.18.4",
    "isbot": "^5.1.36",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@react-router/dev": "7.18.4",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.11"
  }
}
